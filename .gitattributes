.github/workflows/*.lock.yml linguist-generated=true
# gh-aw's sub-agent parser needs LF; keep these LF on Windows checkouts too.
.github/workflows/*.md text eol=lf
.github/workflows/shared/*.md text eol=lf
.github/agents/*.md text eol=lf
# Prettier writes LF; check frontend files out as LF on Windows too, so format:check matches CI.
devel-frontend/** text=auto eol=lf

# Shell scripts must be LF, or bash (WSL, Linux, macOS) fails on the CR.
*.sh text eol=lf
